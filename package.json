{
  "name": "ao-ponto", "private": true, "version": "0.1.0",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @ao-ponto/api\" \"npm run dev -w @ao-ponto/web\"",
    "build": "npm run build -w @ao-ponto/web",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @ao-ponto/api",
    "db:seed": "npm run db:seed -w @ao-ponto/api"
  },
  "devDependencies": {"concurrently": "^9.2.1"},
  "engines": {"node": ">=22"}
}
